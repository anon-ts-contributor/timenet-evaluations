# Configuration for reaching the repository the `timef` extra resolves from.
# Copy to .env and fill in only what you need. .env is gitignored and must never be committed.
#
# Locally you usually need NOTHING here: `make configure-source` will point git at the GitHub CLI,
# so no token is written to disk. Set the token only where no interactive helper exists, such as
# continuous integration.

# A GitHub token with Contents: read on the source repository.
# TIMENET_SOURCE_TOKEN=github_pat_...

# Override only if the source moves.
# TIMENET_SOURCE_HOST=github.com
# TIMENET_SOURCE_REPO=OpenTSLM/TimeNet
